    "oauth4webapi": "^3.8.7",
    "otplib": "^13.5.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.26.0",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
